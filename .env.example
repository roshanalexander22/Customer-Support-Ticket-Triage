# Customer Support Ticket Triage - Environment Configuration
# Copy this file to .env and configure the values as needed.

# Gemini API Key (optional - system falls back to robust deterministic rule-based/heuristic mode if omitted)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection
GEMINI_MODEL=gemini-2.5-flash

# Policy & Threshold Configuration
MAX_AUTONOMOUS_REFUND_AMOUNT=50.00
CRITICAL_SENTIMENT_THRESHOLD=0.30
HIGH_LTV_VIP_THRESHOLD=1000.00

# LangGraph & Checkpointing
ENABLE_CHECKPOINTER=true
CHECKPOINT_DB_PATH=data/checkpoints.sqlite

# Logging & Telemetry
LOG_LEVEL=INFO
SAVE_AUDIT_LOGS=true
AUDIT_LOG_DIR=results/logs

